{
  "title": "Leyline optional Hyper key",
  "rules": [{
    "description": "Hold Caps Lock for Command + Control + Option + Shift",
    "manipulators": [{
      "type": "basic",
      "from": {"key_code": "caps_lock", "modifiers": {"optional": ["any"]}},
      "to": [{"key_code": "left_shift", "modifiers": ["left_command", "left_control", "left_option"]}]
    }]
  }]
}
