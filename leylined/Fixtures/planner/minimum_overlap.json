    "exceeds_display_row": {
      "_doc": "Windows 2 and 3 each need 1000 points in one 1918-point row: no cut fits and window 2's quadrant is only 958.5 wide, so it grows 260.75 both ways from its tile, and window 3 grows left from the display edge.",
      "expect": "overlap",
      "topology": {"displays": [{"id": 1, "frame": {"x": 0, "y": 0, "w": 1920, "h": 1243}, "usable": {"x": 0, "y": 38, "w": 1920, "h": 1205}}], "gap": 1, "outer_gap": 1},
      "segments": [
        {"axis": "v", "coord": 960, "lo": 39, "hi": 1242},
        {"axis": "h", "coord": 640.5, "lo": 1, "hi": 960},
        {"axis": "h", "coord": 640.5, "lo": 960, "hi": 1919},
        {"axis": "v", "coord": 480.5, "lo": 39, "hi": 640.5}
      ],
      "bindings": {
        "1:0:0": {"window_id": 1},
        "1:1:0": {"window_id": 2, "min_size": {"w": 1000}},
        "1:2:0": {"window_id": 3, "min_size": {"w": 1000}},
        "1:0:1": {"window_id": 4},
        "1:2:1": {"window_id": 5}
      },
      "expected_frames": {
        "1": [1, 39, 479, 601],
        "2": [220.25, 39, 1000, 601],
        "3": [919, 39, 1000, 601],
        "4": [1, 641, 958.5, 601],
        "5": [960.5, 641, 958.5, 601]
      },
      "expected_overlap": [2, 3]
    },
    "exceeds_display": {
      "_doc": "Window 2 needs 2000 points on a 1918-point display: no growth can hold it, so automatic overload resolution keeps every member in one explicit stack.",
      "expect": "fallback",
      "topology": {"displays": [{"id": 1, "frame": {"x": 0, "y": 0, "w": 1920, "h": 1243}, "usable": {"x": 0, "y": 38, "w": 1920, "h": 1205}}], "gap": 1, "outer_gap": 1},
      "segments": [
        {"axis": "v", "coord": 960, "lo": 39, "hi": 1242},
