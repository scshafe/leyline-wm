{
  "schema": "leyline/minimum-overlap/v2",
  "_doc": "Hand-computed frames for windows whose known minimum exceeds their tile. When some cut fits every known floor, lines move the least distance to reach it, inner splits before the lines bounding their parcel (expect: recut). Otherwise the lines that can still move do, and a window grows across cuts that split its own band, anchored at the edges it does not share, so it overlaps only the windows those cuts separate; when its split cannot hold it, it grows from the display edges it touches over its neighbours (expect: overlap). Only a minimum larger than the display falls back to automatic overload resolution (expect: fallback).",
  "scenes": {
    "quadrant_pair": {
      "_doc": "Live 2x2 layout with the top-left quadrant split by v480.5 (spanning only that quadrant). Window 2 needs 574 points: the inner split moves to 385, so window 1 keeps 383.5 and the quadrant line v960 stays.",
      "expect": "recut",
      "topology": {"displays": [{"id": 1, "frame": {"x": 0, "y": 0, "w": 1920, "h": 1243}, "usable": {"x": 0, "y": 38, "w": 1920, "h": 1205}}], "gap": 1, "outer_gap": 1},
      "segments": [
        {"axis": "v", "coord": 960, "lo": 39, "hi": 1242},
        {"axis": "h", "coord": 640.5, "lo": 1, "hi": 960},
        {"axis": "h", "coord": 640.5, "lo": 960, "hi": 1919},
        {"axis": "v", "coord": 480.5, "lo": 39, "hi": 640.5}
      ],
      "bindings": {
        "1:0:0": {"window_id": 1},
        "1:1:0": {"window_id": 2, "min_size": {"w": 574}},
        "1:2:0": {"window_id": 3},
        "1:0:1": {"window_id": 4},
        "1:2:1": {"window_id": 5}
      },
      "expected_frames": {
        "1": [1, 39, 383.5, 601],
        "2": [385.5, 39, 574, 601],
        "3": [960.5, 39, 958.5, 601],
        "4": [1, 641, 958.5, 601],
        "5": [960.5, 641, 958.5, 601]
      }
    },
    "exceeds_region": {
      "_doc": "The same layout with a 1000-point minimum. The inner split cannot make room inside the 958.5-point quadrant, so the full-height line v960 moves to 1481.5; the inner split then fits where it is.",
      "expect": "recut",
      "topology": {"displays": [{"id": 1, "frame": {"x": 0, "y": 0, "w": 1920, "h": 1243}, "usable": {"x": 0, "y": 38, "w": 1920, "h": 1205}}], "gap": 1, "outer_gap": 1},
      "segments": [
        {"axis": "v", "coord": 960, "lo": 39, "hi": 1242},
        {"axis": "h", "coord": 640.5, "lo": 1, "hi": 960},
        {"axis": "h", "coord": 640.5, "lo": 960, "hi": 1919},
        {"axis": "v", "coord": 480.5, "lo": 39, "hi": 640.5}
      ],
      "bindings": {
        "1:0:0": {"window_id": 1},
        "1:1:0": {"window_id": 2, "min_size": {"w": 1000}},
        "1:2:0": {"window_id": 3},
        "1:0:1": {"window_id": 4},
        "1:2:1": {"window_id": 5}
      },
      "expected_frames": {
        "1": [1, 39, 479, 601],
        "2": [481, 39, 1000, 601],
        "3": [1482, 39, 437, 601],
        "4": [1, 641, 1480, 601],
        "5": [1482, 641, 437, 601]
      }
    },
    "three_column_shift": {
      "_doc": "Columns 0..100, 100..500 and 500..1200. Window 2 needs 700: v100 alone cannot make room, so v500 moves to 800 and window 3 keeps 400.",
      "expect": "recut",
      "topology": {"displays": [{"id": 1, "frame": {"x": 0, "y": 0, "w": 1200, "h": 800}}], "gap": 0, "outer_gap": 0},
      "segments": [
        {"axis": "v", "coord": 100, "lo": 0, "hi": 800},
        {"axis": "v", "coord": 500, "lo": 0, "hi": 800}
      ],
      "bindings": {
        "1:0:0": {"window_id": 1},
        "1:1:0": {"window_id": 2, "min_size": {"w": 700}},
        "1:2:0": {"window_id": 3}
      },
      "expected_frames": {
        "1": [0, 0, 100, 800],
        "2": [100, 0, 700, 800],
        "3": [800, 0, 400, 800]
      }
    },
    "column_vertical": {
      "_doc": "Left column 0..600; right column split by h400 (spanning only that column). Window 3 needs 500 points of height: h400 moves up to 300.",
      "expect": "recut",
      "topology": {"displays": [{"id": 1, "frame": {"x": 0, "y": 0, "w": 1200, "h": 800}}], "gap": 0, "outer_gap": 0},
      "segments": [
        {"axis": "v", "coord": 600, "lo": 0, "hi": 800},
