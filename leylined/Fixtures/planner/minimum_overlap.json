      "topology": {"displays": [{"id": 1, "frame": {"x": 0, "y": 0, "w": 1920, "h": 1243}, "usable": {"x": 0, "y": 38, "w": 1920, "h": 1205}}], "gap": 1, "outer_gap": 1},
