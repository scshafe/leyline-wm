      "bindings": {
        "1:0:0": {"window_id": 1, "min_size": {"w": 420}},
        "1:1:0": {"window_id": 2, "min_size": {"w": 574}},
        "1:2:0": {"window_id": 3, "min_size": {"w": 958}},
        "1:0:1": {"window_id": 4},
        "1:2:1": {"window_id": 5}
      },
      "expected_frames": {
        "1": [1, 39, 479, 601],
        "2": [385.5, 39, 574, 601],
        "3": [960.5, 39, 958.5, 601],
        "4": [1, 641, 958.5, 601],
        "5": [960.5, 641, 958.5, 601]
      },
      "expected_overlap": [2]
