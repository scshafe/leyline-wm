      ],
      "bindings": {
        "1:0:0": {"window_id": 1},
        "1:1:0": {"window_id": 2},
        "1:1:1": {"window_id": 3, "min_size": {"h": 500}}
      },
      "expected_frames": {
        "1": [0, 0, 600, 800],
        "2": [600, 0, 600, 300],
        "3": [600, 300, 600, 500]
      }
    },
