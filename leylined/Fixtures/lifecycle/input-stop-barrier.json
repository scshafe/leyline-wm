    {
      "name": "duplicate_ack_cannot_repeat_resume",
      "steps": [
        {"op": "resume", "event": "start", "expect": {"stop_calls": 1, "events": [], "overflows": 0}},
        {"op": "ack", "callback": 0, "expect": {"stop_calls": 1, "events": ["did_stop", "start"], "overflows": 0}},
        {"op": "ack", "callback": 0, "expect": {"stop_calls": 1, "events": ["did_stop", "start"], "overflows": 0}}
      ]
    },
    {
      "name": "old_duplicate_ack_cannot_release_fresh_stop",
      "steps": [
        {"op": "resume", "event": "first_start", "expect": {"stop_calls": 1, "events": [], "overflows": 0}},
        {"op": "ack", "callback": 0, "expect": {"stop_calls": 1, "events": ["did_stop", "first_start"], "overflows": 0}},
        {"op": "resume", "event": "fresh_start", "expect": {"stop_calls": 2, "events": ["did_stop", "first_start"], "overflows": 0}},
        {"op": "when_stopped", "event": "fresh_maintenance_ack", "expect": {"stop_calls": 2, "events": ["did_stop", "first_start"], "overflows": 0}},
        {"op": "ack", "callback": 0, "expect": {"stop_calls": 2, "events": ["did_stop", "first_start"], "overflows": 0}},
        {"op": "ack", "callback": 1, "expect": {"stop_calls": 2, "events": ["did_stop", "first_start", "did_stop", "fresh_maintenance_ack", "fresh_start"], "overflows": 0}}
