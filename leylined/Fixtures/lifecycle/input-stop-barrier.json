        {"op": "ack", "callback": 0, "expect": {"stop_calls": 1, "events": ["did_stop", "maintenance_ack_0", "maintenance_ack_1", "maintenance_ack_2", "maintenance_ack_3", "maintenance_ack_4", "maintenance_ack_5", "maintenance_ack_6", "maintenance_ack_7"], "overflows": 1}}
