{
  "schema": "leyline/input-stop-barrier-tests/v1",
  "stop_event": "did_stop",
  "scenarios": [
    {
      "name": "restart_then_stop_late_ack_never_resumes",
      "steps": [
        {"op": "resume", "event": "obsolete_restart", "expect": {"stop_calls": 1, "events": [], "overflows": 0}},
        {"op": "stop", "expect": {"stop_calls": 1, "events": [], "overflows": 0}},
        {"op": "ack", "callback": 0, "expect": {"stop_calls": 1, "events": ["did_stop"], "overflows": 0}}
      ]
    },
    {
      "name": "stop_then_start_waits_for_actual_teardown",
      "steps": [
        {"op": "stop", "expect": {"stop_calls": 1, "events": [], "overflows": 0}},
        {"op": "resume", "event": "start", "expect": {"stop_calls": 1, "events": [], "overflows": 0}},
        {"op": "ack", "callback": 0, "expect": {"stop_calls": 1, "events": ["did_stop", "start"], "overflows": 0}}
      ]
    },
