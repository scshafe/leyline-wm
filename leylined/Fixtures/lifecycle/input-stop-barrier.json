    {
      "name": "maintenance_acknowledges_only_after_teardown_and_after_did_stop",
      "steps": [
        {"op": "resume", "event": "obsolete_restart", "expect": {"stop_calls": 1, "events": [], "overflows": 0}},
        {"op": "stop", "expect": {"stop_calls": 1, "events": [], "overflows": 0}},
        {"op": "when_stopped", "event": "maintenance_input_ack", "expect": {"stop_calls": 1, "events": [], "overflows": 0}},
        {"op": "ack", "callback": 0, "expect": {"stop_calls": 1, "events": ["did_stop", "maintenance_input_ack"], "overflows": 0}}
      ]
    },
    {
      "name": "maintenance_waiter_overflow_never_fabricates_ninth_ack",
      "steps": [
        {"op": "when_stopped", "event": "maintenance_ack_0", "expect": {"stop_calls": 1, "events": [], "overflows": 0}},
        {"op": "when_stopped", "event": "maintenance_ack_1", "expect": {"stop_calls": 1, "events": [], "overflows": 0}},
        {"op": "when_stopped", "event": "maintenance_ack_2", "expect": {"stop_calls": 1, "events": [], "overflows": 0}},
