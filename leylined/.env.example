# Optional runtime overrides; no dotenv loader is used.
# Defaults use per-user state and immutable application resources.

# Absolute state/config root, default ~/.config/leyline.
LEYLINE_ROOT=/absolute/path/to/private-state

# Absolute immutable resource root containing keymap/ and config/registry/.
# Bundled default is Leyline.app/Contents/Resources/leyline.
# Source development/test wrappers set this to the checkout root.
LEYLINE_HOME=/absolute/path/to/immutable-resources

# Absolute socket/log directory, default LEYLINE_ROOT/runtime.
LEYLINE_RUNTIME_DIR=/absolute/path/to/private-state/runtime

# Absolute settings directory, default LEYLINE_ROOT/config.
LEYLINE_CONFIG_DIR=/absolute/path/to/private-state/config

# Thin-client Unix socket override. The server uses core --socket PATH.
LEYLINE_CORE_SOCKET=/absolute/path/to/private-state/runtime/sockets/leylined.sock

# Developer build only: compile the isolated self-test/oracle profile.
# Shipping builds leave this unset.
LEYLINE_BUILD_TESTS=1

# Optional deliberate local signing identity; default is anonymous ad-hoc.
# Distribution signing additionally requires Developer ID and notarization.
LEYLINE_CODESIGN_IDENTITY=-
