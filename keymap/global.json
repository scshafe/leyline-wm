{
  "_schema": "Global chord-to-action source for Leyline v1. Global routes are available in default, move and resize; modal bindings take precedence.",
  "bindings": [
    {
      "chord": "cmd + ctrl + alt + shift - h",
      "action_id": "nav.focus.west"
    },
    {
      "chord": "cmd + ctrl + alt + shift - j",
      "action_id": "nav.focus.south"
    },
    {
      "chord": "cmd + ctrl + alt + shift - k",
      "action_id": "nav.focus.north"
    },
    {
      "chord": "cmd + ctrl + alt + shift - l",
      "action_id": "nav.focus.east"
    },
    {
      "chord": "cmd + ctrl + alt + shift - a",
      "action_id": "space.management.toggle"
    },
    {
      "chord": "ctrl + alt - r",
      "action_id": "service.restart"
    }
  ]
}
