{
  "note": "the full two-dimensional diff in one shot: incoming minimized window 10 → show, outgoing visible window 11 → hide, a window 12 present in both layouts but drifted → reframe, and a correctly-placed window 13 → noop. This is what a real context switch reduces to (presented-set diff + frame diff).",
  "targets": {
    "10": {
      "window_id": 10,
      "presented": true,
      "frame": {
        "x": 0,
        "y": 0,
        "w": 500,
        "h": 800
      }
    },
    "11": {
      "window_id": 11,
      "presented": false,
      "frame": null
    },
    "12": {
      "window_id": 12,
      "presented": true,
      "frame": {
        "x": 500,
        "y": 0,
        "w": 500,
        "h": 800
      }
    },
    "13": {
      "window_id": 13,
      "presented": true,
      "frame": {
        "x": 0,
        "y": 0,
        "w": 1000,
        "h": 400
      }
    }
  },
  "observed": [
    {
      "window_id": 10,
      "frame": {
        "x": 0,
        "y": 0,
        "w": 500,
        "h": 800
      },
      "minimized": true
    },
    {
      "window_id": 11,
      "frame": {
        "x": 0,
        "y": 0,
        "w": 999,
        "h": 800
      },
      "minimized": false
    },
    {
      "window_id": 12,
      "frame": {
        "x": 480,
        "y": 0,
        "w": 520,
        "h": 800
      },
      "minimized": false
    },
    {
      "window_id": 13,
      "frame": {
        "x": 0,
        "y": 0,
        "w": 1000,
        "h": 400
      },
      "minimized": false
    }
  ],
  "expect": {
    "diff": {
      "hide": [
        {
          "window_id": 11
        }
      ],
      "noop": [
        {
          "window_id": 13
        }
      ],
      "reframe": [
        {
          "frame": {
            "h": 800,
            "w": 500,
            "x": 500,
            "y": 0
