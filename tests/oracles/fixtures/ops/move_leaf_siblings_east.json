{
  "note": "warp the focused leaf a EAST onto its sibling b (row/after). Detach a (collapses r → b becomes root), then split b re-inserting a after it. Result: fresh node i:a=[b,a] as root. (In the 2-leaf case this coincides with swap — emergent, not special-cased; also exercises split_leaf's target==root branch.)",
  "tree": {
    "root_id": "r",
    "nodes": {
      "r": {
        "id": "r",
        "mode": "row",
        "children": [
          "a",
          "b"
        ]
      },
      "a": {
        "id": "a",
        "window_id": 1
      },
      "b": {
        "id": "b",
        "window_id": 2
      }
    }
  },
  "op": "move_leaf",
  "args": {
    "focused": "a",
    "target": "b",
    "orientation": "row",
    "side": "after"
  },
  "expect": {
    "ok": true,
    "tree": {
      "nodes": {
        "a": {
          "id": "a",
          "window_id": 1
        },
        "b": {
          "id": "b",
          "window_id": 2
        },
        "i:a": {
          "children": [
            "b",
            "a"
          ],
          "id": "i:a",
          "mode": "row"
        }
      },
      "root_id": "i:a"
    }
  }
}
